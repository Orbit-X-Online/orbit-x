# Copy to .dev.vars for local dev (never commit .dev.vars).
# In production set each one with:  npx wrangler secret put NAME
MODEL_API_KEY=            # Meta Model API key from dev.meta.ai
WHATSAPP_TOKEN=           # WhatsApp Cloud API permanent/system-user token
WHATSAPP_PHONE_ID=        # WhatsApp test number phone-number ID
WHATSAPP_VERIFY_TOKEN=    # any random string you choose; paste same value in Meta webhook setup
# MODEL_REASONING=low     # optional: minimal|low|medium|high|xhigh (only set if the model accepts it)
