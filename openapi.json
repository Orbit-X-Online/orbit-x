  "/api/receipt/{pid}/{shareId}": {
   "get": {
    "tags": [
     "Public"
    ],
    "summary": "Public integrity receipt",
    "description": "Capability URL created by the patient. Returns only step kinds, times, fingerprints and the server verification result. Never medical details.",
    "parameters": [
     {
      "name": "pid",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "shareId",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Receipt",
      "content": {
       "application/json": {
        "example": {
         "ok": true,
         "type": "handoff",
         "status": "acknowledged",
         "serverVerified": true,
         "signature": "unsigned",
         "entries": [
          {
           "t": 1793134322530,
           "k": "accepted",
           "label": "Event accepted",
           "d": "<hash>",
           "h": "<hash>"
          }
         ]
        }
       }
      }
     },
     "404": {
      "description": "no_receipt"
     }
    }
   }
  },
