      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    },
    "security": [
     {
      "ApiKey": []
     },
     {
      "Bearer": []
     }
    ],
    "parameters": [
     {
      "name": "id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "example": "ho_x7k2m9q4ab"
      }
     }
    ]
   }
  },
  "/api/v1/handoffs/{id}/acknowledge": {
   "post": {
    "tags": [
     "Orbit Connect"
    ],
    "summary": "Receiving system acknowledges",
