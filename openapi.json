  "/api/h/{pid}/apikey": {
   "post": {
    "tags": [
     "Key management (patient session)"
    ],
    "summary": "Create an API key",
    "description": "Authenticated with the patient's session token (`Authorization: Bearer <token>`), not with an API key. The key is returned once; only its hash is stored. Max 5 keys.",
    "security": [
     {
      "Bearer": []
     }
    ],
    "parameters": [
     {
      "name": "pid",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     }
    ],
    "requestBody": {
     "content": {
      "application/json": {
       "example": {
        "label": "Clinic system",
        "scopes": [
         "records:write",
         "records:read"
        ],
        "simulated": false
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "Key",
      "content": {
       "application/json": {
        "example": {
         "ok": true,
         "key": "ox_ab12cd34_<secret>",
         "keyId": "k1793134322530",
         "scopes": [
          "records:write",
          "records:read"
         ]
        }
       }
      }
     },
     "400": {
      "description": "no_valid_scopes"
     },
     "409": {
      "description": "too_many_keys"
     }
    }
   }
  },
  "/api/h/{pid}/apikeydel": {
   "post": {
    "tags": [
     "Key management (patient session)"
    ],
    "summary": "Revoke an API key",
    "description": "Immediate. Access tokens issued from the key stop working too.",
    "security": [
     {
      "Bearer": []
     }
    ],
    "parameters": [
     {
      "name": "pid",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     }
    ],
    "requestBody": {
     "content": {
      "application/json": {
       "example": {
        "id": "k1793134322530"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "Revoked"
     }
    }
   }
  }
