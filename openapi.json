       }
      }
     }
    },
    "parameters": [
     {
      "name": "id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "example": "ho_x7k2m9q4ab"
      }
     }
    ]
   }
  },
  "/api/v1/receipts/{id}/verify": {
   "get": {
    "tags": [
     "Orbit Connect"
    ],
    "summary": "Verify a handoff receipt on the server",
    "description": "Recomputes the hash chain and the content hash from stored data and checks the HMAC signature when `RECEIPT_SECRET` is configured (otherwise reports `unsigned`). Integrity only; says nothing about medical accuracy. Required scope: `handoff:create, handoff:receive or audit:read`.",
    "responses": {
     "200": {
      "description": "Success",
      "content": {
       "application/json": {
        "example": {
         "ok": true,
         "verification": {
          "chainIntact": true,
          "contentMatchesHash": true,
          "signature": "unsigned",
          "integrityOk": true,
          "status": "acknowledged"
         }
        }
       }
      }
     },
     "401": {
      "description": "Missing, invalid or revoked key/token",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "403": {
      "description": "Key lacks the required scope",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "429": {
      "description": "Rate limit: 60 requests per minute per key. Retry-After header says when.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "404": {
      "description": "not_found",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    },
    "security": [
     {
      "ApiKey": []
     },
     {
      "Bearer": []
     }
    ],
    "parameters": [
     {
      "name": "id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "example": "ho_x7k2m9q4ab"
      }
     }
    ]
