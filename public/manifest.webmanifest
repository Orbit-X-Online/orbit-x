{
  "name": "Orbit-X",
  "short_name": "Orbit-X",
  "description": "Orbit-X: health-information intelligence and interoperability. Your records, evidence-linked explanations, FHIR exchange, and optional family alerts.",
  "start_url": "/?guardian=1",
  "scope": "/",
  "display": "standalone",
  "background_color": "#070B16",
  "theme_color": "#070B16",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "id": "/",
  "lang": "en",
  "orientation": "portrait",
  "categories": [
    "health",
    "medical"
  ],
  "shortcuts": [
    {
      "name": "Rule Studio (doctors)",
      "url": "/studio.html",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "prefer_related_applications": false,
  "dir": "ltr",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "screenshots": [
    {
      "src": "/shot-home.png",
      "sizes": "540x960",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Orbit with your tablets and blood pressure"
    },
    {
      "src": "/shot-history.png",
      "sizes": "540x960",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Your history and trends"
    },
    {
      "src": "/shot-wide.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Orbit on a computer"
    }
  ]
}
